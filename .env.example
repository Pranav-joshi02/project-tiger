# Application
APP_ENV=development
SECRET_KEY=change-me-before-deployment

# Database
DATABASE_URL=postgresql+psycopg://pench:pench@localhost:5432/pench

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_ROOT=storage

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=miniosecret
MINIO_SECURE=false
MINIO_BUCKET_RAW=pench-raw
MINIO_BUCKET_QUARANTINE=pench-quarantine
MINIO_BUCKET_PROCESSED=pench-processed

# Authentication
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ML Models
MEGADETECTOR_VERSION=MDV6-mit-yolov9-c
TRIAGE_SUBJECT_THRESHOLD=0.80
TRIAGE_BLANK_THRESHOLD=0.30

# Re-ID
REID_AUTO_THRESHOLD=0.90
REID_MARGIN_THRESHOLD=0.08
REID_EMBEDDING_DIM=512

# Spatial Analytics
CORE_RANGE_SHIFT_THRESHOLD_KM2=15
BUFFER_MOVEMENT_THRESHOLD_KM=5

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
